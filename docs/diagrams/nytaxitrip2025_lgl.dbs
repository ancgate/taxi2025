<?xml version="1.0" encoding="UTF-8" ?>
<project name="nytaxitrip2025" database="LogicalDesign" id="LogicalDesign-162d" >
	<schema name="nytaxitrip2025" >
		<table name="dim_calendar" prior="Entity" >
			<column name="date_id" type="BIGINT" jt="-5" mandatory="y" />
			<column name="year_number" type="INT" jt="4" />
			<column name="quarter_number" type="INT" jt="4" />
			<column name="month_number" type="INT" jt="4" />
			<column name="day_number" type="INT" jt="4" />
			<column name="hour_number" type="INT" jt="4" />
			<column name="week_of_month" type="INT" jt="4" />
			<column name="week_of_year" type="INT" jt="4" />
			<column name="holiday" type="BOOLEAN" jt="-7" />
			<column name="weekend" type="BOOLEAN" jt="-7" />
			<column name="month_name" type="VARCHAR" length="25" jt="12" />
			<column name="day_name" type="VARCHAR" length="25" jt="12" />
			<index name="pk_dim_calendar" unique="PRIMARY_KEY" >
				<column name="date_id" />
			</index>
		</table>
		<table name="dim_license" prior="Entity" >
			<column name="dim_license_id" type="INT" jt="4" mandatory="y" />
			<index name="pk_dim_license" unique="PRIMARY_KEY" >
				<column name="dim_license_id" />
			</index>
		</table>
		<table name="dim_location" prior="Entity" >
			<column name="location_id" type="INT" jt="4" mandatory="y" />
			<column name="borough" type="VARCHAR" length="100" jt="12" />
			<column name="zone" type="VARCHAR" length="100" jt="12" />
			<column name="service_zone" type="VARCHAR" length="100" jt="12" />
